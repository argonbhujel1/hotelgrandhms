# ── Shared Aiven PostgreSQL (SAME as public site) ──────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
SECRET_KEY=generate-a-long-random-string-here
FLASK_ENV=production
FLASK_DEBUG=0

# Domains
PUBLIC_SITE_URL=https://hotelgrand.com.np
HMS_SITE_URL=https://hms.hotelgrand.com.np

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Email (optional)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@hotelgrand.com.np
